# Applied after scripts/desktop/q706f-desktop.config when building 7.3:
# options the 7.1 config had under a name that no longer exists in 7.3.
# 7.1: CONFIG_CRYPTO_DEV_QCOM_RNG=m (drivers/crypto) -> 7.3: drivers/char/hw_random/qcom-rng.c
# (sm8250.dtsi rng@793000, compatible "qcom,prng-ee").
CONFIG_HW_RANDOM_QCOM=m
