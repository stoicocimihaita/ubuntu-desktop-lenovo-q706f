# Fingerprint (stage 0/1) fragment, merged after the normal q706f fragments
# (q706f-desktop.config, q706f-7.3-renames.config, q706f-7.3.4-extra.config).
# Needs the patches in this directory; without them TEE_QSEECOM and
# INPUT_GOODIX_FP_SPI do not exist and merge_config only warns.

# Legacy QSEECOM interface in qcom_scm (bool, needs QCOM_SCM=y, which we have).
CONFIG_QCOM_QSEECOM=y
# uefisecapp needs EFI; we boot through ABL without EFI variables.
# CONFIG_QCOM_QSEECOM_UEFISECAPP is not set

# TEE core is already built in (CONFIG_TEE=y in the base config).
CONFIG_TEE=y
# QSEECOM TEE driver from the series: /dev/teeN + /dev/teeprivN, impl_id 5.
# A module, so it only binds when loaded on purpose (stage 2).
CONFIG_TEE_QSEECOM=m
# The object-based smcinvoke driver is not used: the Goodix TA only answers on QSEECOM.
# CONFIG_QCOMTEE is not set

# TZ memory: start with the generic allocator (dma_alloc_coherent from CMA).
# If QSEE refuses the buffers at TA load (stage 4), the fallback to try is
# CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y (the stock kernel uses QTEE_SHM_BRIDGE).
CONFIG_QCOM_TZMEM_MODE_GENERIC=y
# CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE is not set

# MDT loader stays built in (the series makes it user-visible).
CONFIG_QCOM_MDT_LOADER=y

# Goodix sensor control driver: /dev/goodix_fp, reset/IRQ/supply, netlink 25.
CONFIG_INPUT_GOODIX_FP_SPI=m

# No RPMB path on purpose (the supplicant does not implement listener 8192).
# CONFIG_RPMB is not set

# The TA load needs ~13.4 MB contiguous; CMA is already 64 MiB in
# q706f-7.3.4-extra.config (CONFIG_CMA_SIZE_MBYTES=64). Repeated here so this
# fragment stays correct on its own.
CONFIG_CMA_SIZE_MBYTES=64
