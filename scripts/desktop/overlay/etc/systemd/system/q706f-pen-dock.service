[Unit]
Description=Precision Pen 3 dock: charger state and Bluetooth connect (q706f)
Documentation=file:/usr/local/libexec/q706f-pen-dock
# Enabled through the multi-user.target.wants symlink in the overlay.
After=bluetooth.service systemd-modules-load.service

[Service]
# Make sure detection is on when the service starts, and end any wireless-charging
# session cleanly when it stops (shutdown/reboot): a session cut off mid-way left the
# pen's NFC tag with a zero NDEF length on 2026-11-13, which disabled charging.
ExecStartPre=-/bin/sh -c 'echo 1 > /sys/class/misc/ctn730/enable'
ExecStart=/usr/local/libexec/q706f-pen-dock
ExecStopPost=-/bin/sh -c 'echo 0 > /sys/class/misc/ctn730/enable; sleep 1'
Restart=on-failure
RestartSec=5
RuntimeDirectory=q706f-pen-dock
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
