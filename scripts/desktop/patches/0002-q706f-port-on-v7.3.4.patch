+		threshold = BQ2597X_AC_OVP_BASE;
+
+	if (threshold == BQ2597X_AC_OVP_6P5V)
+		val = 0x07;
+	else
+		val = (threshold - BQ2597X_AC_OVP_BASE) /  BQ2597X_AC_OVP_LSB;
+
+	val <<= BQ2597X_AC_OVP_SHIFT;
+
+	ret = bq2597x_update_bits(bq, BQ2597X_REG_05,
