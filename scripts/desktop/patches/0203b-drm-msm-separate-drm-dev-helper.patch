drm/msm: Centralize the standalone drm device check for GPU

Origin: upstream RFT series "[PATCH RFT 0/5] drm/msm: Attach a driver to GMU",
        patch 2/5, not merged (v1; v2 announced, not seen on lore by 13.11.2026).
        https://lore.kernel.org/all/20260513-gmu-sync-state-fix-v1-2-6e33e6aa9b4f@oss.qualcomm.com/
        Author: Akhil P Oommen <akhilpo@oss.qualcomm.com>, Wed, 13 May 2026 02:22:57 +0530
        Review: Reviewed-by Dmitry Baryshkov on 1/5, 3/5, 5/5; Tested-by on
        x1e80100, sm8750, sc8280xp. Not tested on SM8250 / Adreno 650.
Status: .pending - apply only together with the other 0203* files, for the
        power test kernel (out/desktop/kernel-power). Rename to .patch to apply.

Original commit message:
Replace msm_gpu_no_components() with msm_gpu_use_separate_drm_dev() and
move the platform-specific check for "amd,imageon" into the helper so the
policy is centralized and reused by both the core driver and adreno probe
path. No functional change intended.

Signed-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>

--- a/drivers/gpu/drm/msm/adreno/adreno_device.c	2026-11-10 20:10:10.000000000 +0200
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c	2026-11-13 17:55:12.585367455 +0200
@@ -271,8 +271,7 @@
 
 static int adreno_probe(struct platform_device *pdev)
 {
-	if (of_device_is_compatible(pdev->dev.of_node, "amd,imageon") ||
-	    msm_gpu_no_components())
+	if (msm_gpu_use_separate_drm_dev(pdev))
 		return msm_gpu_probe(pdev, &a3xx_ops);
 
 	return component_add(&pdev->dev, &a3xx_ops);
--- a/drivers/gpu/drm/msm/msm_drv.c	2026-11-10 20:10:10.000000000 +0200
+++ b/drivers/gpu/drm/msm/msm_drv.c	2026-11-13 17:55:12.585454754 +0200
@@ -61,9 +61,12 @@
 DECLARE_FAULT_ATTR(fail_gem_alloc);
 DECLARE_FAULT_ATTR(fail_gem_iova);
 
-bool msm_gpu_no_components(void)
+bool msm_gpu_use_separate_drm_dev(struct platform_device *pdev)
 {
-	return separate_gpu_kms;
+	if (!pdev)
+		return separate_gpu_kms;
+
+	return of_device_is_compatible(pdev->dev.of_node, "amd,imageon") || separate_gpu_kms;
 }
 
 static int msm_drm_uninit(struct device *dev, const struct component_ops *gpu_ops)
@@ -1040,7 +1043,7 @@
 static int msm_drm_bind(struct device *dev)
 {
 	return msm_drm_init(dev,
-			    msm_gpu_no_components() ?
+			    msm_gpu_use_separate_drm_dev(NULL) ?
 				    &msm_kms_driver :
 				    &msm_driver,
 			    NULL);
@@ -1079,7 +1082,7 @@
 			return ret;
 	}
 
-	if (!msm_gpu_no_components()) {
+	if (!msm_gpu_use_separate_drm_dev(NULL)) {
 		ret = add_gpu_components(master_dev, &match);
 		if (ret)
 			return ret;
--- a/drivers/gpu/drm/msm/msm_drv.h	2026-11-10 20:10:10.000000000 +0200
+++ b/drivers/gpu/drm/msm/msm_drv.h	2026-11-13 17:55:12.585543064 +0200
@@ -534,6 +534,6 @@
 
 bool msm_disp_drv_should_bind(struct device *dev, bool dpu_driver);
 
-bool msm_gpu_no_components(void);
+bool msm_gpu_use_separate_drm_dev(struct platform_device *pdev);
 
 #endif /* __MSM_DRV_H__ */
