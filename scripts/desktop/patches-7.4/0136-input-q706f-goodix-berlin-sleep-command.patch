From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] Input: goodix-berlin: opt in to sleep before power-off

Use the existing command and ACK protocol before the normal GT9916
power-off sequence. Record the result and keep normal reset and pen
mode restoration on resume.

diff --git a/drivers/input/touchscreen/goodix_berlin_core.c b/drivers/input/touchscreen/goodix_berlin_core.c
index 196d1f4c63cd0714ba4c587503a382e6eea8e8e5..fed5de50a7a6c9b6d263f7ced7b19f50ce5cfdb8 100644
--- a/drivers/input/touchscreen/goodix_berlin_core.c
+++ b/drivers/input/touchscreen/goodix_berlin_core.c
@@ -31,6 +31,7 @@
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/property.h>
+#include <linux/suspend.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
 #include <linux/sizes.h>
@@ -70,6 +71,7 @@
 #define GOODIX_BERLIN_CMD_ACK_BUSY		0x02
 #define GOODIX_BERLIN_CMD_ACK_BUFFER_OVERFLOW	0x03
 #define GOODIX_BERLIN_CMD_ACK_OK		0x80
+#define GOODIX_BERLIN_CMD_SLEEP			0x84
 #define GOODIX_BERLIN_CMD_PEN_ON		0x14
 #define GOODIX_BERLIN_CMD_PEN_OFF		0x15
 
@@ -957,11 +959,27 @@ static int goodix_berlin_set_pen_mode(struct goodix_berlin_core *cd, bool on)
 	return ret == GOODIX_BERLIN_CMD_ACK_OK ? 0 : -EIO;
 }
 
+static bool sleep_before_poweroff;
+module_param(sleep_before_poweroff, bool, 0644);
+MODULE_PARM_DESC(sleep_before_poweroff,
+		 "Q706F: send the GT9916 sleep command before powering it off");
+
 static int goodix_berlin_suspend(struct device *dev)
 {
 	struct goodix_berlin_core *cd = dev_get_drvdata(dev);
+	int ret;
 
 	disable_irq(cd->irq);
+	if (pm_suspend_target_state == PM_SUSPEND_TO_IDLE &&
+	    READ_ONCE(sleep_before_poweroff) && cd->cmd_addr &&
+	    of_machine_is_compatible("lenovo,q706f") &&
+	    device_is_compatible(dev, "goodix,gt9916")) {
+		ret = goodix_berlin_send_cmd(cd, GOODIX_BERLIN_CMD_SLEEP);
+		if (ret != GOODIX_BERLIN_CMD_ACK_OK)
+			dev_warn(dev, "sleep command ack/error: %d\n", ret);
+		else
+			dev_info(dev, "sleep command acknowledged\n");
+	}
 	goodix_berlin_power_off(cd);
 
 	return 0;
