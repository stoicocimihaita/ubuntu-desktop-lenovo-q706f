+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&pm8009_gpios 1 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&cam0_default>, <&cam0_rst_default>;
+		pinctrl-names = "default";
+
