From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] Input: goodix-berlin - separate stylus hover from tip contact, fix tilt

On top of the v2 stylus support patch:

- BTN_TOOL_PEN now means "pen in range" and BTN_TOUCH "tip pressed"
  (pressure > 0). Both were set together, so hovering counted as contact
  and no tip up/down was seen between strokes. The vendor driver has the
  same limitation and leaves it to Android to look at the pressure.
- The angles are signed 16-bit in 0.01 degree (vendor driver: int16_t
  x_angle / 100). Dividing the unsigned value and casting to s8 turned
  every negative angle into garbage. Clamp to +-90 and set the tilt
  resolution so userspace gets degrees.
- Drop ABS_DISTANCE: the firmware reports no distance, the axis was a
  made-up 0/1 on a 0..255 range.
- When the pen leaves range, zero the pressure and release BTN_TOUCH and
  the barrel buttons before BTN_TOOL_PEN.

diff --git a/drivers/input/touchscreen/goodix_berlin_core.c b/drivers/input/touchscreen/goodix_berlin_core.c
index f67d8cdd291b687eadc01c64dda70faf3db7a55c..5ab31d98678d887c3426444cccd140194be642db 100644
--- a/drivers/input/touchscreen/goodix_berlin_core.c
+++ b/drivers/input/touchscreen/goodix_berlin_core.c
@@ -495,40 +495,58 @@ static void goodix_berlin_mt_report(struct goodix_berlin_core *cd, int n)
 }
 
 static void goodix_berlin_stylus_report(struct goodix_berlin_core *cd,
-					u8 btn_pressed, bool down)
+					u8 btn_pressed, bool in_range)
 {
 	struct goodix_berlin_stylus *s =
 	(struct goodix_berlin_stylus *)cd->event.data;
 
 	struct input_dev *dev = cd->stylus_dev;
-	s8 tilt_x, tilt_y;
+	int tilt_x, tilt_y;
+	u16 pressure;
 	int i;
 
 	if (!dev)
 		return;
 
-	input_report_key(dev, BTN_TOUCH, down);
-	input_report_key(dev, BTN_TOOL_PEN, down);
+	if (!in_range) {
+		/* Pen left the sensing range: lift the tip, then the tool */
+		input_report_abs(dev, ABS_PRESSURE, 0);
+		input_report_key(dev, BTN_TOUCH, 0);
+		for (i = 0; i < GOODIX_BERLIN_MAX_STYLUS_BTN; i++)
+			input_report_key(dev, stylus_btn[i], 0);
+		input_report_key(dev, BTN_TOOL_PEN, 0);
+		input_sync(dev);
+		return;
+	}
 
-	if (!down)
-		goto key_report;
+	/*
+	 * The firmware reports the pen for as long as it is in range, with
+	 * zero pressure while it hovers. The angles are signed, in units of
+	 * 0.01 degree.
+	 */
+	pressure = le16_to_cpu(s->p);
+	tilt_x = clamp((s16)le16_to_cpu(s->x_angle) / 100,
+		       -GOODIX_BERLIN_STYLUS_MAX_TILT,
+		       GOODIX_BERLIN_STYLUS_MAX_TILT);
+	tilt_y = clamp((s16)le16_to_cpu(s->y_angle) / 100,
+		       -GOODIX_BERLIN_STYLUS_MAX_TILT,
+		       GOODIX_BERLIN_STYLUS_MAX_TILT);
 
-	tilt_x = (s8)(le16_to_cpu(s->x_angle) / 100);
-	tilt_y = (s8)(le16_to_cpu(s->y_angle) / 100);
+	input_report_key(dev, BTN_TOOL_PEN, 1);
 
 	touchscreen_report_pos(dev, &cd->props, le16_to_cpu(s->x),
 			       le16_to_cpu(s->y), false);
 
-	input_report_abs(dev, ABS_PRESSURE, le16_to_cpu(s->p));
-	input_report_abs(dev, ABS_DISTANCE, !le16_to_cpu(s->p));
+	input_report_abs(dev, ABS_PRESSURE, pressure);
 	input_report_abs(dev, ABS_TILT_X, tilt_x);
 	input_report_abs(dev, ABS_TILT_Y, tilt_y);
+	input_report_key(dev, BTN_TOUCH, pressure > 0);
 
-	dev_dbg(&dev->dev, "stylus: x: %d, y: %d, pressure: %d, tilt_x: %d tilt_y: %d, btn: %d",
-		le16_to_cpu(s->x), le16_to_cpu(s->y), le16_to_cpu(s->p), tilt_x,
+	dev_dbg(&dev->dev, "stylus: type: %lu, x: %d, y: %d, pressure: %d, tilt_x: %d tilt_y: %d, btn: %d",
+		FIELD_GET(GOODIX_BERLIN_POINT_TYPE_MASK, s->status),
+		le16_to_cpu(s->x), le16_to_cpu(s->y), pressure, tilt_x,
 		tilt_y, btn_pressed);
 
-key_report:
 	for (i = 0; i < GOODIX_BERLIN_MAX_STYLUS_BTN; i++)
 		input_report_key(dev, stylus_btn[i],
 				 !!(btn_pressed & (1 << i)));
@@ -789,13 +807,15 @@ static int goodix_berlin_stylus_dev_config(struct goodix_berlin_core *cd,
 	input_abs_set_res(stylus_dev, ABS_X, cd->props.max_x / width);
 	input_abs_set_res(stylus_dev, ABS_Y, cd->props.max_y / height);
 	input_set_abs_params(stylus_dev, ABS_PRESSURE, 0, p_lvl - 1, 0, 0);
-	input_set_abs_params(stylus_dev, ABS_DISTANCE, 0, 255, 0, 0);
 	input_set_abs_params(stylus_dev, ABS_TILT_X,
 			     -GOODIX_BERLIN_STYLUS_MAX_TILT,
 			     GOODIX_BERLIN_STYLUS_MAX_TILT, 0, 0);
 	input_set_abs_params(stylus_dev, ABS_TILT_Y,
 			     -GOODIX_BERLIN_STYLUS_MAX_TILT,
 			     GOODIX_BERLIN_STYLUS_MAX_TILT, 0, 0);
+	/* Tilt is reported in degrees: 57 units per radian */
+	input_abs_set_res(stylus_dev, ABS_TILT_X, 57);
+	input_abs_set_res(stylus_dev, ABS_TILT_Y, 57);
 
 	return input_register_device(stylus_dev);
 }
