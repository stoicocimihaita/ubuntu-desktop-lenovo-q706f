From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] ASoC: cs35l45: TEMPMON global override around CSPL, correct error IRQ names

The vendor (Lenovo) cs35l45 module sets GLOBAL_OVERRIDES (0x2020) bit 3
TEMPMON_GLOBAL_OVR before sending RESUME to the speaker-protection
firmware and clears it after PAUSE; mainline never touches it.
Do the same.

cs35l45_spk_safe_err() derived the table index by subtracting the Linux
IRQ number of hwirq 0, which assumes contiguous virqs; on q706f it
printed "Unspecified global error condition (267)" and mislabelled
interrupts. Look the IRQ up in the table instead.
---
diff -ru a/sound/soc/codecs/cs35l45.c b/sound/soc/codecs/cs35l45.c
--- a/sound/soc/codecs/cs35l45.c	2026-11-20 09:05:23.000902640 +0200
+++ b/sound/soc/codecs/cs35l45.c	2026-11-20 09:05:31.995249518 +0200
@@ -154,14 +154,29 @@
 {
 	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
 	struct cs35l45_private *cs35l45 = snd_soc_component_get_drvdata(component);
+	int ret;
 
+	/*
+	 * The vendor driver holds the temperature-monitor global override
+	 * while the protection algorithm runs: set it before RESUME, clear it
+	 * after PAUSE.
+	 */
 	switch (event) {
 	case SND_SOC_DAPM_POST_PMU:
-		return cs35l45_set_cspl_mbox_cmd(cs35l45, cs35l45->regmap,
-						 CSPL_MBOX_CMD_RESUME);
+		regmap_set_bits(cs35l45->regmap, CS35L45_GLOBAL_OVERRIDES,
+				CS35L45_TEMPMON_GLOBAL_OVR_MASK);
+		ret = cs35l45_set_cspl_mbox_cmd(cs35l45, cs35l45->regmap,
+						CSPL_MBOX_CMD_RESUME);
+		if (ret)
+			regmap_clear_bits(cs35l45->regmap, CS35L45_GLOBAL_OVERRIDES,
+					  CS35L45_TEMPMON_GLOBAL_OVR_MASK);
+		return ret;
 	case SND_SOC_DAPM_PRE_PMD:
-		return cs35l45_set_cspl_mbox_cmd(cs35l45, cs35l45->regmap,
-						 CSPL_MBOX_CMD_PAUSE);
+		ret = cs35l45_set_cspl_mbox_cmd(cs35l45, cs35l45->regmap,
+						CSPL_MBOX_CMD_PAUSE);
+		regmap_clear_bits(cs35l45->regmap, CS35L45_GLOBAL_OVERRIDES,
+				  CS35L45_TEMPMON_GLOBAL_OVR_MASK);
+		return ret;
 	default:
 		return 0;
 	}
@@ -1235,12 +1250,15 @@
 	struct cs35l45_private *cs35l45 = data;
 	int i;
 
-	i = irq - regmap_irq_get_virq(cs35l45->irq_data, 0);
+	/* Linux IRQ numbers of the regmap-irq domain need not be contiguous */
+	for (i = 0; i < ARRAY_SIZE(cs35l45_irqs); i++) {
+		if (regmap_irq_get_virq(cs35l45->irq_data, cs35l45_irqs[i].irq) == irq) {
+			dev_err(cs35l45->dev, "%s condition detected!\n", cs35l45_irqs[i].name);
+			return IRQ_HANDLED;
+		}
+	}
 
-	if (i < 0 || i >= ARRAY_SIZE(cs35l45_irqs))
-		dev_err(cs35l45->dev, "Unspecified global error condition (%d) detected!\n", irq);
-	else
-		dev_err(cs35l45->dev, "%s condition detected!\n", cs35l45_irqs[i].name);
+	dev_err(cs35l45->dev, "Unspecified global error condition (%d) detected!\n", irq);
 
 	return IRQ_HANDLED;
 }
diff -ru a/sound/soc/codecs/cs35l45.h b/sound/soc/codecs/cs35l45.h
--- a/sound/soc/codecs/cs35l45.h	2026-11-20 09:05:23.001212738 +0200
+++ b/sound/soc/codecs/cs35l45.h	2026-11-20 09:05:23.008360419 +0200
@@ -23,6 +23,7 @@
 #define CS35L45_OTPID				0x00000010
 #define CS35L45_SFT_RESET			0x00000020
 #define CS35L45_GLOBAL_ENABLES			0x00002014
+#define CS35L45_GLOBAL_OVERRIDES		0x00002020
 #define CS35L45_BLOCK_ENABLES			0x00002018
 #define CS35L45_BLOCK_ENABLES2			0x0000201C
 #define CS35L45_ERROR_RELEASE			0x00002034
@@ -166,6 +167,9 @@
 #define CS35L45_IMON_EN_SHIFT			13
 #define CS35L45_VMON_EN_SHIFT			12
 #define CS35L45_TEMPMON_EN_SHIFT		10
+
+/* GLOBAL_OVERRIDES */
+#define CS35L45_TEMPMON_GLOBAL_OVR_MASK		BIT(3)
 #define CS35L45_VDD_BSTMON_EN_SHIFT		9
 #define CS35L45_VDD_BATTMON_EN_SHIFT		8
 #define CS35L45_BST_EN_SHIFT			4
diff -ru a/sound/soc/codecs/cs35l45-tables.c b/sound/soc/codecs/cs35l45-tables.c
--- a/sound/soc/codecs/cs35l45-tables.c	2026-11-20 09:05:23.001393397 +0200
+++ b/sound/soc/codecs/cs35l45-tables.c	2026-11-20 09:05:23.008390299 +0200
@@ -122,6 +122,7 @@
 	case CS35L45_DEVID ... CS35L45_OTPID:
 	case CS35L45_SFT_RESET:
 	case CS35L45_GLOBAL_ENABLES:
+	case CS35L45_GLOBAL_OVERRIDES:
 	case CS35L45_BLOCK_ENABLES:
 	case CS35L45_BLOCK_ENABLES2:
 	case CS35L45_ERROR_RELEASE:
