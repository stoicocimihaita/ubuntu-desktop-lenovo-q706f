From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] q706f dts: add the NXP CTN730 pen charger (i2c1 @ 0x28)

Stock DT (dtbo, fragment@98, target qupv3_se1_i2c = i2c@984000): ctn730@28 with
interrupt-gpios = tlmm 111, rst-gpios = tlmm 6 (pinctrl: pull-up, output-high),
enable-gpios = pm8150l gpio 8. Verified on the running tablet with the out-of-tree
driver (scripts/desktop/modules/ctn730): the chip ACKs at 0x28 once VEN is high
and reports firmware 1041. The driver is not in the kernel tree yet, so this node
only takes effect once ctn730.ko is installed.

diff --git a/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts b/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts
index 90c3f364cdfce3ff119f7f267113e25bf53bf979..aebb83ddb1a17a5e487969e7b359835d62dc43ec 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts
@@ -861,8 +861,24 @@ zap-shader {
 &i2c1 {
 	status = "okay";
 	clock-frequency = <1000000>;
-	/* Pen Charging NXP CTN730 Qi charger @ 28 */
 
+	/* NXP CTN730 NFC wireless charger for the Precision Pen 3 (back cover) */
+	pen-charger@28 {
+		compatible = "nxp,ctn730";
+		reg = <0x28>;
+
+		interrupts-extended = <&tlmm 111 IRQ_TYPE_LEVEL_HIGH>;
+		enable-gpios = <&pm8150l_gpios 8 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ctn730_default>, <&ctn730_en>;
+
+		/*
+		 * No "wakeup-source": docking or removing the pen does not wake
+		 * the tablet. The chip keeps charging on its own during suspend.
+		 */
+	};
 };
 
 &i2c3 {
@@ -1367,6 +1383,14 @@ &pm8150l_gpios {
 	"NC", /* GPIO_10 */
 	"NC",
 	"PM3003A_MODE";
+
+	ctn730_en: ctn730-en-state {
+		pins = "gpio8";
+		function = "normal";
+		power-source = <0>;
+		bias-disable;
+		output-low;
+	};
 };
 
 &pm8150b_charger {
@@ -1740,6 +1764,22 @@ touchscreen@0 {
 &tlmm {
 	gpio-reserved-ranges = <40 4>;
 
+	ctn730_default: ctn730-default-state {
+		irq-pins {
+			pins = "gpio111";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		reset-pins {
+			pins = "gpio6";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
 	hall_sensor_default: hall-sensor-default-state {
 		pins = "gpio121";
 		function = "gpio";
