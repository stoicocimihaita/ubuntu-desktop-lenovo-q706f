# Applied last when building 7.4 (build-kernel-7.4.sh), after q706f-desktop.config,
# q706f-7.3-renames.config and q706f-7.3.4-extra.config: options renamed or newly
# introduced in 7.4 that the q706f build needs.

# Since 7.4 more Qualcomm clock/interconnect/pinctrl drivers of other SoCs are
# "default ARCH_QCOM" (same policy as q706f-7.3.4-extra.config): none can bind on SM8250.
# CONFIG_CLK_ELIZA_CAMCC is not set
# CONFIG_CLK_ELIZA_GCC is not set
# CONFIG_CLK_ELIZA_GPUCC is not set
# CONFIG_CLK_ELIZA_VIDEOCC is not set
# CONFIG_CLK_GLYMUR_GCC is not set
# CONFIG_CLK_GLYMUR_GPUCC is not set
# CONFIG_CLK_HAWI_CAMCC is not set
# CONFIG_CLK_HAWI_GCC is not set
# CONFIG_CLK_HAWI_GPUCC is not set
# CONFIG_CLK_NORD_CAMCC is not set
# CONFIG_CLK_NORD_GCC is not set
# CONFIG_CLK_NORD_VIDEOCC is not set
# CONFIG_INTERCONNECT_QCOM_ELIZA is not set
# CONFIG_INTERCONNECT_QCOM_GLYMUR is not set
# CONFIG_INTERCONNECT_QCOM_HAWI is not set
# CONFIG_INTERCONNECT_QCOM_KAANAPALI is not set
# CONFIG_INTERCONNECT_QCOM_MILOS is not set
# CONFIG_INTERCONNECT_QCOM_NORD is not set
# CONFIG_INTERCONNECT_QCOM_QCS615 is not set
# CONFIG_INTERCONNECT_QCOM_QCS8300 is not set
# CONFIG_INTERCONNECT_QCOM_SAR2130P is not set
# CONFIG_INTERCONNECT_QCOM_SHIKRA is not set
# CONFIG_INTERCONNECT_QCOM_SM8750 is not set
# CONFIG_MSM_GCC_8952 is not set
# CONFIG_PINCTRL_MSM8952 is not set

# Not carried over from 7.3.4 (no equivalent here):
#  - CONFIG_ANDROID_BINDER_IPC: the C binder driver is gone in 7.4, only the Rust one
#    (ANDROID_BINDER_IPC_RUST, needs CONFIG_RUST) is left. Not used by the desktop rootfs.
#  - CONFIG_QCOM_TZMEM_MODE_GENERIC: the choice was removed; generic is the default when
#    QCOM_TZMEM_MODE_SHMBRIDGE is off (as before).
