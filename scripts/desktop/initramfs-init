#!/bin/busybox sh
# Bring-up initramfs for the mainline kernel on q706f.
# Default: diagnostics only (USB NCM gadget 172.16.42.1 + telnet root shell).
# With q706f.rootimg=<file> on the cmdline: loop-mount /<file> from the userdata
# partition (ext4, shared with Ubuntu Touch) and switch_root into it; falls back to
# the diagnostics shell when that fails.
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /tmp /run /sys/kernel/config /data /newroot
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs tmpfs /run

# Every stage goes to the kernel log, so it also lands in ramoops (pstore console).
say() { echo "q706f-init: $*" > /dev/kmsg; echo "q706f-init: $*" > /dev/tty0 2>/dev/null; }
say "start, kernel $(uname -r)"

coldplug() {
  for pass in 1 2 3; do
    find /sys/devices -name modalias -exec cat {} + 2>/dev/null | sort -u | \
      xargs modprobe -a -q 2>/dev/null
    sleep 1
  done
}

gadget() {
  i=0; while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done
  UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
  [ -n "$UDC" ] || { say "USB: no UDC found"; return 1; }
  G=/sys/kernel/config/usb_gadget/g1
  mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ncm.usb0
  echo 0x18d1 > $G/idVendor; echo 0xd001 > $G/idProduct
  echo "Lenovo" > $G/strings/0x409/manufacturer
  echo "q706f mainline bring-up" > $G/strings/0x409/product
  echo "NCM" > $G/configs/c.1/strings/0x409/configuration
  ln -s $G/functions/ncm.usb0 $G/configs/c.1/
  echo "$UDC" > $G/UDC
  sleep 2
  ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
  printf 'start 172.16.42.2\nend 172.16.42.2\ninterface usb0\noption subnet 255.255.255.0\nlease_file /run/udhcpd.leases\n' > /run/udhcpd.conf
  touch /run/udhcpd.leases
  udhcpd /run/udhcpd.conf
  telnetd -l /bin/sh -p 23
  say "USB: $UDC up, telnet 172.16.42.1"
}

ungadget() {
  G=/sys/kernel/config/usb_gadget/g1
  [ -d $G ] || return 0
  killall telnetd udhcpd 2>/dev/null
  echo "" > $G/UDC 2>/dev/null
  rm -f $G/configs/c.1/ncm.usb0
  rmdir $G/configs/c.1/strings/0x409 $G/configs/c.1 $G/functions/ncm.usb0 $G/strings/0x409 $G 2>/dev/null
}

find_part() {  # $1 = GPT partition name
  for u in /sys/class/block/*/uevent; do
    if grep -q "^PARTNAME=$1\$" "$u"; then echo "/dev/$(basename "$(dirname "$u")")"; return 0; fi
  done
  return 1
}

boot_rootimg() {
  IMG="$1"
  i=0; while ! DEV=$(find_part userdata) && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done
  [ -n "$DEV" ] || { say "userdata partition not found"; return 1; }
  say "userdata is $DEV"
  # A journal left dirty by another kernel (e.g. Ubuntu Touch's 4.19, whose journal
  # checksums the mainline kernel refuses) would stop the mount: replay/repair it first.
  # -p only applies fixes that are safe without a human; exit >= 4 means it refused.
  if [ -x /bin/e2fsck ]; then
    /bin/e2fsck -p "$DEV" > /run/e2fsck-userdata.txt 2>&1; rc=$?
    [ $rc -ne 0 ] && { while read -r l; do say "e2fsck: $l"; done < /run/e2fsck-userdata.txt; }
    say "e2fsck userdata: exit $rc"
    [ $rc -ge 4 ] && { say "e2fsck could not repair userdata, not mounting"; return 1; }
  fi
  mount -t ext4 -o rw,noatime "$DEV" /data || { say "cannot mount userdata"; return 1; }
  [ -f "/data/$IMG" ] || { say "/data/$IMG missing"; umount /data; return 1; }
  [ -x /bin/e2fsck ] && /bin/e2fsck -p "/data/$IMG" >/dev/null 2>&1
  mount -t ext4 -o loop,rw,noatime "/data/$IMG" /newroot || { say "cannot mount $IMG"; umount /data; return 1; }
  [ -x /newroot/sbin/init ] || [ -L /newroot/sbin/init ] || { say "no /sbin/init in $IMG"; return 1; }
  say "switching root to $IMG"
  mkdir -p /newroot/userdata
  mount -o move /data /newroot/userdata 2>/dev/null
  umount /dev/pts /sys/kernel/config /run 2>/dev/null
  mount -o move /dev /newroot/dev; mount -o move /proc /newroot/proc; mount -o move /sys /newroot/sys
  exec switch_root /newroot /sbin/init
}

IMG=$(sed -n 's/.*q706f\.rootimg=\([^ ]*\).*/\1/p' /proc/cmdline)
if [ -n "$IMG" ]; then
  say "rootimg mode: $IMG"
  boot_rootimg "$IMG"
  say "rootimg boot failed, falling back to diagnostics"
fi

gadget
say "coldplug"
coldplug
say "coldplug done"
[ -d /sys/kernel/config/usb_gadget/g1 ] || gadget
dmesg > /run/dmesg-boot.txt
while true; do sleep 3600; done
