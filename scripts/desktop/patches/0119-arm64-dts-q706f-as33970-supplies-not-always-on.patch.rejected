From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] arm64: dts: qcom: q706f: do not keep the AS33970 supplies always on

The far-field DSP (AS33970) has no driver in use, yet its VBAT (L13A) and AVDD 1.3 V
(GPIO 61 switch) were always on, powering an idle chip in suspend. Stock leaves L13A
unused and off. Drop regulator-always-on/boot-on so both rails stay off unless a driver
enables them.
---
--- a/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts	2026-11-17 07:05:57.776253694 +0200
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts	2026-11-17 07:05:57.781236763 +0200
@@ -218,8 +218,7 @@
 		regulator-max-microvolt = <1300000>;
 		gpio = <&tlmm 61 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
-		regulator-boot-on;
-		regulator-always-on;
+		/* only the AS33970 uses it; off unless its driver enables it */
 	};
 	audio2_1p8_supply: audio2-1p8-regulator {
 		compatible = "regulator-fixed";
@@ -690,7 +689,7 @@
 			regulator-max-microvolt = <3008000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
-			regulator-always-on;
+			/* AS33970 VBAT only; stock leaves L13A unused and off */
 		};
 		// display vddio/vddi
 		vreg_l14a_1p8: ldo14 {
