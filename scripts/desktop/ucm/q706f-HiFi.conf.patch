q706f changes to the ALSA UCM profile of silime/ubuntu-lenovo-q706f
(alsa-lenovo-q706f/usr/share/alsa/ucm2/Lenovo/q706f/HiFi.conf, author chalkin).

1. Speaker level: 'SPKn Digital PCM Volume' = 409 (0 dB, as in stock Android) on
   all four CS35L45 amplifiers. On mainline the DAC is fed straight from ASP_RX;
   the Cirrus protection DSP (excursion/thermal limiting) is not in the path.
   The overlay puts a PipeWire filter-chain in front (-8 dB headroom, high-pass,
   limiter: /etc/pipewire/filter-chain.conf.d/60-q706f-speaker-headroom.conf)
   because the amplifier inputs saturated above ~75 % volume. Do not raise it
   and do not remove the filter: the speakers have no protection.
2. Internal microphones: SectionDevice "Mic" (WCD938x AMIC1 + AMIC3 through
   the TX macro, TX_CODEC_DMA_TX_3 -> MultiMedia2), gains as in the stock
   Android mixer_paths.

Applied by scripts/desktop/ucm/fetch-ucm.sh with `patch -p1` inside ucm2/.
---
--- a/Lenovo/q706f/HiFi.conf
+++ b/Lenovo/q706f/HiFi.conf
@@ -1,8 +1,22 @@
+# Source: https://github.com/silime/ubuntu-lenovo-q706f (alsa-lenovo-q706f) by chalkin (silime),
+# downloaded and patched at image build time by scripts/desktop/ucm/fetch-ucm.sh.
+# Local changes (scripts/desktop/ucm/q706f-HiFi.conf.patch):
+#  - 'Digital PCM Volume' = 409 (0 dB, as stock) on every amp, with an 8 dB digital
+#    pre-attenuation in front (PipeWire filter-chain 60-q706f-speaker-headroom.conf). The DAC
+#    is fed straight from ASP_RX: the speakers have no excursion/thermal protection.
+#  - internal microphones (WCD938x) added as a capture device.
+# Needs 16-bit PCM on the front end: see /etc/wireplumber/wireplumber.conf.d/51-q706f-audio-format.conf
 # Use case configuration for Xiaoxin Pad Pro 12.6
 # Author: chalkin <chalkin@yeah.net>
 #
 # Playback Devices
 #  - Internal Speakers   : CS35L45 driver : MultiMedia1 <-> PRIMARY_TDM_RX_0
+#
+# Capture Devices
+#  - Internal Microphones : WCD938x AMIC1 + AMIC3 (stock "dual-amic" path) :
+#    TX macro DEC0/DEC1 -> TX_CODEC_DMA_TX_3 <-> MultiMedia2
+#    (the ES7210 + AS33970 far-field array on SENARY MI2S is not used: the DSP
+#    needs a firmware download at every boot)
 
 SectionVerb {
 	EnableSequence [
@@ -22,6 +36,7 @@
 		cset "name='SPK1 DSP_RX6 Source' VDD_BSTMON"
 		cset "name='SPK1 DSP_RX7 Source' CLASSH_TGT"
 		cset "name='SPK1 Analog PCM Volume' 3"
+		cset "name='SPK1 Digital PCM Volume' 409"
 
 		cset "name='SPK2 DSP1 Firmware' Protection"
 		cset "name='SPK2 DSP1 Preload Switch' 1"
@@ -39,6 +54,7 @@
 		cset "name='SPK2 DSP_RX6 Source' VDD_BSTMON"
 		cset "name='SPK2 DSP_RX7 Source' CLASSH_TGT"
 		cset "name='SPK2 Analog PCM Volume' 3"
+		cset "name='SPK2 Digital PCM Volume' 409"
 
 		cset "name='SPK3 DSP1 Firmware' Protection"
 		cset "name='SPK3 DSP1 Preload Switch' 1"
@@ -56,6 +72,7 @@
 		cset "name='SPK3 DSP_RX6 Source' VDD_BSTMON"
 		cset "name='SPK3 DSP_RX7 Source' CLASSH_TGT"
 		cset "name='SPK3 Analog PCM Volume' 3"
+		cset "name='SPK3 Digital PCM Volume' 409"
 
 
 		cset "name='SPK4 DSP1 Firmware' Protection"
@@ -74,8 +91,10 @@
 		cset "name='SPK4 DSP_RX6 Source' VDD_BSTMON"
 		cset "name='SPK4 DSP_RX7 Source' CLASSH_TGT"
 		cset "name='SPK4 Analog PCM Volume' 3"
+		cset "name='SPK4 Digital PCM Volume' 409"
 
 		cset "name='PRIMARY_TDM_RX_0 Audio Mixer MultiMedia1' 1"
+		cset "name='MultiMedia2 Mixer TX_CODEC_DMA_TX_3' 1"
 
 
 	]
@@ -86,6 +105,7 @@
 		cset "name='SPK3 AMP Enable Switch' 0"
 		cset "name='SPK4 AMP Enable Switch' 0"
 		cset "name='PRIMARY_TDM_RX_0 Audio Mixer MultiMedia1' 0"
+		cset "name='MultiMedia2 Mixer TX_CODEC_DMA_TX_3' 0"
 	]
 
 	Value {
@@ -128,3 +148,48 @@
 	}
 }
 
+SectionDevice."Mic" {
+	Comment "Internal microphones"
+
+	# Gains are the stock Android defaults (mixer_paths_mtp.xml):
+	# ADC 12 dB analog, TX decimator +12 dB digital.
+	EnableSequence [
+		cset "name='TX DEC0 MUX' SWR_MIC"
+		cset "name='TX SMIC MUX0' ADC0"
+		cset "name='TX_AIF1_CAP Mixer DEC0' 1"
+		cset "name='TX_DEC0 Volume' 96"
+		cset "name='TX DEC1 MUX' SWR_MIC"
+		cset "name='TX SMIC MUX1' ADC1"
+		cset "name='TX_AIF1_CAP Mixer DEC1' 1"
+		cset "name='TX_DEC1 Volume' 96"
+		cset "name='HDR12 MUX' NO_HDR12"
+		cset "name='ADC1_MIXER Switch' 1"
+		cset "name='ADC1 Switch' 1"
+		cset "name='TX0 MODE' ADC_NORMAL"
+		cset "name='ADC1 Volume' 8"
+		cset "name='ADC2 MUX' INP3"
+		cset "name='ADC2_MIXER Switch' 1"
+		cset "name='ADC2 Switch' 1"
+		cset "name='TX1 MODE' ADC_NORMAL"
+		cset "name='ADC2 Volume' 8"
+	]
+
+	DisableSequence [
+		cset "name='TX_AIF1_CAP Mixer DEC0' 0"
+		cset "name='TX SMIC MUX0' ZERO"
+		cset "name='TX_AIF1_CAP Mixer DEC1' 0"
+		cset "name='TX SMIC MUX1' ZERO"
+		cset "name='ADC1_MIXER Switch' 0"
+		cset "name='ADC1 Switch' 0"
+		cset "name='TX0 MODE' ADC_INVALID"
+		cset "name='ADC2_MIXER Switch' 0"
+		cset "name='ADC2 Switch' 0"
+		cset "name='TX1 MODE' ADC_INVALID"
+	]
+
+	Value {
+		CapturePriority 200
+		CapturePCM "hw:${CardId},1"
+		CaptureChannels 2
+	}
+}
