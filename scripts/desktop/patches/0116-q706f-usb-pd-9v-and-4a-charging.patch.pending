From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] q706f: accept 9 V from USB-PD chargers, charge at up to 4 A

The connector only listed a 5 V sink PDO, so a PD charger (tested: OnePlus
120 W, PDOs 9/12/15/20 V 3 A + PPS) was used at 5 V 3 A. Add 9 V 3 A; the
PM8150B input already allows 5 V or 9-12 V (USBIN_ADAPTER_ALLOW_CFG = 7).

Raise the battery charge current to 4 A, the stock limit on the main
charger alone (qcom,jeita-fcc-ranges-hvdcp3), and cap the warm zone
(45-50 degC) at 3 A like the stock qcom,jeita-fcc-ranges; the cool zone is
already limited to 1.5 A.

--- a/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-lenovo-q706f.dts
@@ -83,7 +83,7 @@
 		 * outside the 15-45 degC window and its first thermal
 		 * mitigation level.
 		 */
-		constant-charge-current-max-microamp = <3000000>;
+		constant-charge-current-max-microamp = <4000000>;
 		/*
 		 * Vendor qcom,chg-term-current-ma = <(-1700)>: charging ends
 		 * once the cell is at the float voltage and takes less than
@@ -1474,7 +1474,7 @@
 	connector {
 		compatible = "usb-c-connector";
 
-		op-sink-microwatt = <10000000>;
+		op-sink-microwatt = <27000000>;
 		power-role = "dual";
 		data-role = "dual";
 		self-powered;
@@ -1484,10 +1484,16 @@
 		PDO_FIXED_USB_COMM |
 		PDO_FIXED_DATA_SWAP)>;
 
+		/*
+		 * 9 V 3 A from USB-PD chargers: the PM8150B USBIN accepts 5 V or
+		 * 9-12 V (USBIN_ADAPTER_ALLOW_CFG = 7). Higher PD levels and PPS
+		 * belong to the SMB1396 charge pumps, which have no driver here.
+		 */
 		sink-pdos = <PDO_FIXED(5000, 3000,
 		PDO_FIXED_DUAL_ROLE |
 		PDO_FIXED_USB_COMM |
-		PDO_FIXED_DATA_SWAP)>;
+		PDO_FIXED_DATA_SWAP)
+		PDO_FIXED(9000, 3000, 0)>;
 
 		altmodes {
 			displayport {
--- a/drivers/power/supply/qcom_pm8150b_charger.c
+++ b/drivers/power/supply/qcom_pm8150b_charger.c
@@ -318,6 +318,12 @@
 #define TEMP_PLAUSIBLE_MAX		1000
 /* Vendor: 1.5 A in the cool range once the cell is above 4.2 V */
 #define COOL_CHARGE_CURRENT_UA		1500000
+/*
+ * Vendor qcom,jeita-fcc-ranges: 3 A at 0-15 degC and 45.1-50 degC; up to 4 A
+ * in between on the main charger alone (qcom,jeita-fcc-ranges-hvdcp3), the
+ * 9.5 A of the stock profile needs the SMB1396 charge pumps.
+ */
+#define WARM_CHARGE_CURRENT_UA		3000000
 /* Vendor qcom,jeita-fv-ranges, 45.1-50 degC */
 #define WARM_FLOAT_VOLTAGE_UV		4200000
 #define THERMAL_POLL_MS			10000
@@ -735,6 +741,7 @@
 		fcc_ua = min(fcc_ua, COOL_CHARGE_CURRENT_UA);
 		break;
 	case TEMP_WARM:
+		fcc_ua = min(fcc_ua, WARM_CHARGE_CURRENT_UA);
 		fv_uv = min(fv_uv, WARM_FLOAT_VOLTAGE_UV);
 		break;
 	case TEMP_COLD:
