#!/bin/sh
# Apply the low-power switches listed in /etc/default/q706f-lpm (see that file).
# Some drivers are modules that load late: wait up to 60 s for each module (not for a
# parameter that an older kernel lacks).
conf=/etc/default/q706f-lpm
[ -r "$conf" ] || exit 0
grep -v '^[[:space:]]*\(#\|$\)' "$conf" | while read -r p; do
  f=/sys/module/${p%%/*}/parameters/${p#*/}
  i=0; while [ ! -d "/sys/module/${p%%/*}" ] && [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done
  if [ -w "$f" ]; then echo 1 > "$f"; echo "$p=$(cat "$f")"; else echo "$p: missing"; fi
done
