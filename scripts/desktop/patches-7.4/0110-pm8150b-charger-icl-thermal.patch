+ * current and the warm float voltage together, which is within the vendor
+ * limits anywhere inside the allowed window.
+ */
+enum smb5_temp_zone {
+	TEMP_COLD = 0,
+	TEMP_COOL,
+	TEMP_NORMAL,
+	TEMP_WARM,
+	TEMP_HOT,
+	TEMP_UNKNOWN,
+};
