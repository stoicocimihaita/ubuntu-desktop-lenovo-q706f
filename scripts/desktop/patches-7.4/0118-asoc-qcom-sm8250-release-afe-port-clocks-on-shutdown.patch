From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] ASoC: qcom: sm8250: release AFE port bit clocks on shutdown

sm8250_snd_startup() enables the MI2S/TDM bit clock of the backend through
q6afe set_sysclk, but the backend shutdown only releases the SoundWire
stream, so the LPASS clock stays voted in the ADSP after the first stream.
Request frequency 0 (enable = 0) for the same clock on shutdown.

Same problem as the upstream report "sm8250: shut down MI2S/TDM AFE port
clocks" (2026-04).

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index d9035146e272575773ce69f787118d61db479f40..0bc56cc43479751491bfbd4c22d3787fcc465c7a 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -257,6 +257,59 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_startup(substream);
 }
 
+static void sm8250_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	unsigned int clk_id = 0;
+	int dir = SNDRV_PCM_STREAM_PLAYBACK;
+
+	/*
+	 * startup() enables the AFE bit clock of the port; a request with
+	 * frequency 0 sends enable = 0 to the ADSP. Without it the LPASS
+	 * clock stays voted after the stream closes and the ADSP never lets
+	 * LPASS (and therefore CX) collapse.
+	 */
+	switch (cpu_dai->id) {
+	case SENARY_MI2S_TX:
+		clk_id = Q6AFE_LPASS_CLK_ID_SEN_MI2S_EBIT;
+		dir = SNDRV_PCM_STREAM_CAPTURE;
+		break;
+	case PRIMARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_PRI_MI2S_IBIT;
+		break;
+	case SECONDARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_SEC_MI2S_IBIT;
+		break;
+	case TERTIARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_TER_MI2S_IBIT;
+		break;
+	case QUINARY_MI2S_RX:
+		clk_id = Q6AFE_LPASS_CLK_ID_QUI_MI2S_IBIT;
+		break;
+	case LPI_MI2S_RX_0:
+		clk_id = Q6AFE_LPASS_CLK_ID_INT0_MI2S_IBIT;
+		break;
+	case LPI_MI2S_TX_3:
+		clk_id = Q6AFE_LPASS_CLK_ID_INT3_MI2S_IBIT;
+		dir = SNDRV_PCM_STREAM_CAPTURE;
+		break;
+	case TERTIARY_TDM_RX_0:
+		clk_id = Q6AFE_LPASS_CLK_ID_TER_TDM_IBIT;
+		break;
+	case PRIMARY_TDM_RX_0:
+		clk_id = Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT;
+		break;
+	default:
+		break;
+	}
+
+	if (clk_id)
+		snd_soc_dai_set_sysclk(cpu_dai, clk_id, 0, dir);
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sm8250_snd_hw_params(struct snd_pcm_substream *substream,
 				struct snd_pcm_hw_params *params)
 {
@@ -291,7 +344,7 @@ static int sm8250_snd_hw_free(struct snd_pcm_substream *substream)
 
 static const struct snd_soc_ops sm8250_be_ops = {
 	.startup = sm8250_snd_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.shutdown = sm8250_snd_shutdown,
 	.hw_params = sm8250_snd_hw_params,
 	.hw_free = sm8250_snd_hw_free,
 	.prepare = sm8250_snd_prepare,
