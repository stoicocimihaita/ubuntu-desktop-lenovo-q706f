+/* Input current limit for a BC1.2 result, see the *_CURRENT_UA comments */
+static unsigned int smb5_apsd_to_current(unsigned int result)
+{
+	if (result & CDP_CHARGER_BIT)
+		return CDP_CURRENT_UA;
+	if (result & (DCP_CHARGER_BIT | QC_2P0_BIT | QC_3P0_BIT))
+		return DCP_CURRENT_UA;
+	if (result & OCP_CHARGER_BIT)
+		return OCP_CURRENT_UA;
+	if (result & FLOAT_CHARGER_BIT)
+		return FLOAT_CURRENT_UA;
+
+	return SDP_CURRENT_UA;
+}
+
+/*
+ * Current advertised by the Type-C source through Rp, 0 for the default
+ * (USB) current. This is read from the PMIC rather than from the TCPM power
+ * supply: for Rp-default TCPM reports whatever qcom_pmic_typec got from this
+ * charger's own CURRENT_MAX, so taking it as a limit would latch the input
+ * current at the value that happened to be set when the cable was attached.
+ */
+static unsigned int smb5_typec_rp_current(struct smb5_chip *chip)
+{
+	unsigned int stat;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->base + TYPE_C_SNK_STATUS, &stat);
+	if (rc < 0)
+		return 0;
+
+	if (stat & SNK_RP_3P0_BIT)
+		return TYPEC_HIGH_CURRENT_UA;
+	if (stat & SNK_RP_1P5_BIT)
+		return TYPEC_MEDIUM_CURRENT_UA;
+
+	return 0;
+}
+
+/* True when TCPM has an explicit PD contract; *current_ua is its current */
+static bool smb5_pd_current(struct smb5_chip *chip, unsigned int *current_ua)
+{
+	union power_supply_propval val;
+	int rc;
+
+	rc = power_supply_get_property_from_supplier(chip->chg_psy,
+						     POWER_SUPPLY_PROP_ONLINE,
+						     &val);
+	if (rc || !val.intval)
+		return false;
+
+	rc = power_supply_get_property_from_supplier(chip->chg_psy,
+						     POWER_SUPPLY_PROP_USB_TYPE,
+						     &val);
+	if (rc)
+		return false;
+
+	switch (val.intval) {
+	case POWER_SUPPLY_USB_TYPE_PD:
+	case POWER_SUPPLY_USB_TYPE_PD_DRP:
+	case POWER_SUPPLY_USB_TYPE_PD_PPS:
+	case POWER_SUPPLY_USB_TYPE_PD_SPR_AVS:
+	case POWER_SUPPLY_USB_TYPE_PD_PPS_SPR_AVS:
+		break;
+	default:
+		return false;
+	}
+
+	/* Do not fall back to an unverified BC1.2 high-current result. */
+	*current_ua = SDP_CURRENT_UA;
+
+	rc = power_supply_get_property_from_supplier(chip->chg_psy,
+						     POWER_SUPPLY_PROP_CURRENT_MAX,
+						     &val);
+	if (!rc && val.intval > 0)
+		*current_ua = min_t(unsigned int, val.intval, CURRENT_MAX_UA);
+
+	return true;
+}
