+static int bq2597x_set_present(struct bq2597x *bq, bool present)
+{
+    if (present != bq->usb_present) {
+        bq_info("changed usb_present [%d] -> [%d]\n", bq->usb_present, present);
+        if (present) {
+            bq2597x_init_device(bq);
+        }
+        bq->usb_present = present;
+    }
+
+	return 0;
+}
