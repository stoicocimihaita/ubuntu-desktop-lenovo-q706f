#!/usr/bin/env python3
"""Read-only dump of a physical range via /dev/mem with aligned 32-bit loads: q706f-physread ADDR LEN OUT."""
import mmap, os, sys
addr, length, out = int(sys.argv[1], 0), int(sys.argv[2], 0), sys.argv[3]
page = addr & ~0xfff
span = ((addr + length + 0xfff) & ~0xfff) - page
fd = os.open("/dev/mem", os.O_RDONLY | os.O_SYNC)
m = mmap.mmap(fd, span, mmap.MAP_SHARED, mmap.PROT_READ, offset=page)
words = memoryview(m).cast("I")
base = (addr - page) // 4
data = b"".join(words[base + i].to_bytes(4, "little") for i in range(length // 4))
open(out, "wb").write(data)
print(f"read {len(data)} bytes at {addr:#x}")
