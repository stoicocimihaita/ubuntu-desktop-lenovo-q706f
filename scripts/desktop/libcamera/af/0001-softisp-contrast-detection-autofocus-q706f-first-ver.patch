+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <map>
+#include <stdint.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Start,
+		Coarse,
+		Fine,
+		Locked,
+	};
+
+	double contrast(const SwIspStats *stats) const;
+	void moveTo(IPAContext &context, int32_t position, unsigned int settle);
+	void startScan(IPAContext &context);
+
+	int32_t min_ = 0;
+	int32_t max_ = 1023;
+	int32_t coarseStep_ = 64;
+	int32_t fineStep_ = 16;
+	double rescanRatio_ = 0.6;
+	unsigned int rescanFrames_ = 4;
+
+	State state_ = State::Start;
+	int32_t position_ = 0;
+	unsigned int skip_ = 0;
+	std::map<int32_t, double> samples_;
+	int32_t bestPos_ = 0;
+	double best_ = -1.0;
+	unsigned int drops_ = 0;
+	int32_t fineEnd_ = 0;
+	double locked_ = 0.0;
+	unsigned int low_ = 0;
+};
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
