From: Stoicoci Mihaita <stoicocimihaita@users.noreply.github.com>
Subject: [PATCH] ASoC: qcom: sm8250: q706f: selectable speaker TDM rate (experiment)

Experiment for the CS35L45 speaker-protection firmware, which does not
process on mainline: the stock setup runs the speaker TDM link at 96 kHz,
mainline forces all backends to 48 kHz. Add a writable parameter
snd_soc_sm8250.q706f_spk_rate (48000 default, or 96000) used for
PRIMARY_TDM_RX_0 only: backend rate and bit clock (2x 12.288 MHz, the
8x32-bit slot layout is kept). Other backends stay at 48 kHz.
---
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -21,6 +21,21 @@
 
 static unsigned int tdm_slot_offset[8] = {0, 4, 8, 12, 16, 20, 24, 28};
 
+/*
+ * q706f experiment: sample rate of the speaker TDM link (PRIMARY_TDM_RX_0).
+ * The stock setup runs it at 96 kHz ("PRI_TDM_RX_0 SampleRate KHZ_96",
+ * CS35L45 "Global Sample Rate 96kHz"); mainline forces every backend to
+ * 48 kHz. 48000 or 96000; read when a stream starts.
+ */
+static unsigned int q706f_spk_rate = 48000;
+module_param(q706f_spk_rate, uint, 0644);
+MODULE_PARM_DESC(q706f_spk_rate, "speaker TDM rate (48000 or 96000), experiment");
+
+static unsigned int q706f_spk_bclk(void)
+{
+	return q706f_spk_rate == 96000 ? 2 * TDM_BCLK_RATE : TDM_BCLK_RATE;
+}
+
 struct sm8250_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
@@ -119,6 +134,8 @@
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
 
 	rate->min = rate->max = 48000;
+	if (snd_soc_rtd_to_cpu(rtd, 0)->id == PRIMARY_TDM_RX_0 && q706f_spk_rate == 96000)
+		rate->min = rate->max = 96000;
 	channels->min = channels->max = 2;
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 
@@ -219,12 +236,12 @@
 	case PRIMARY_TDM_RX_0:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_DSP_A;
 		snd_soc_dai_set_sysclk(cpu_dai,
-			Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT                           ,
-			TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+			q706f_spk_bclk(), SNDRV_PCM_STREAM_PLAYBACK);
 
 		for_each_rtd_codec_dais(rtd, j, codec_dai) {
 			ret = snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
-			snd_soc_dai_set_sysclk(codec_dai, 0, TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			snd_soc_dai_set_sysclk(codec_dai, 0, q706f_spk_bclk(), SNDRV_PCM_STREAM_PLAYBACK);
 			if (ret < 0) {
 				dev_err(rtd->dev, "TDM fmt err:%d\n", ret);
 				return ret;
