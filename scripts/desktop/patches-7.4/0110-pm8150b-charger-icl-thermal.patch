+/*
+ * Nothing watches the battery temperature while the system sleeps or after
+ * it has shut down, but the PMIC keeps charging. Leave it with the restricted
+ * limits, or with charging off if the battery was already too cold or too hot.
+ */
+static void smb5_stop_monitoring(struct smb5_chip *chip)
+{
+	mutex_lock(&chip->lock);
+	chip->asleep = true;
+	mutex_unlock(&chip->lock);
+
+	cancel_delayed_work_sync(&chip->thermal_work);
+
+	mutex_lock(&chip->lock);
+	chip->temp_fails = 0;
+	if (chip->zone != TEMP_COLD && chip->zone != TEMP_HOT)
+		smb5_set_zone(chip, TEMP_UNKNOWN, 0);
+	mutex_unlock(&chip->lock);
+}
