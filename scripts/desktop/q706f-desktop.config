# Fragment merged over the pmOS q706f config (config-pmos-q706f-6.11, known to boot
# this tablet on 6.11) for the Ubuntu Desktop arm64 track.
# Bring-up: plain .ko modules (busybox modprobe), crash log in ramoops.
# CONFIG_MODULE_COMPRESS is not set
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_I2C_HID_OF=m
CONFIG_BT_QCA=m
# systemd / Ubuntu userspace
CONFIG_CGROUPS=y
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# silime 7.1.0-dev: q706f microphones, haptics, CS35L45 amps
CONFIG_SND_SOC_ES7210=m
CONFIG_SND_SOC_AS33970=m
CONFIG_SND_SOC_CS35L45_I2C=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
CONFIG_BATTERY_BQ27XXX=m
CONFIG_BATTERY_BQ27XXX_I2C=m
# silime 7.1.0-dev: charger and cameras
CONFIG_CHARGER_QCOM_SMB5=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_OV13B10=m
CONFIG_VIDEO_S5K5E9=m
CONFIG_VIDEO_OV8856=m
CONFIG_VIDEO_DW9768=m
# Options newer than the pmOS 6.11 config that the 7.1 DTS depends on.
# Without REFGEN the DSI host never probes ("Failed to get supply 'refgen'").
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_SM_CAMCC_8250=m
CONFIG_QCOM_ICC_BWMON=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_LEDS_QCOM_LPG=m
CONFIG_NVMEM_SPMI_SDAM=m
CONFIG_QCOM_PBS=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_RFKILL=y
# From the 2026-11-13 audit: GPU thermal throttling, LSMs, BT profiles, governor, zram.
CONFIG_DEVFREQ_THERMAL=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y

# Tablet-mode switch from the pogo keyboard MCU (patch 0005)
CONFIG_HID_LENOVO_Q706F_KBD=m
# The PMIC RTC cannot be set; do not load 1970 into the system clock at boot.
# CONFIG_RTC_HCTOSYS is not set
# Tailscale: connmark rules (health warning without them).
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NF_CONNTRACK_MARK=y
