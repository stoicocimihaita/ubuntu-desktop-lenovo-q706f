--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -0,0 +1,190 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ *
+ * The software ISP statistics carry a contrast measure (squared differences of
+ * horizontally adjacent green samples in the centre of the frame). This
+ * algorithm sweeps the focus lens coarsely from the far end, stops once the
+ * contrast has clearly passed its peak, refines around the peak with a finer
+ * step and locks. While locked it watches the contrast and starts a new sweep
+ * when it stays well below the locked value (scene or distance change).
+ *
+ * Statistics are computed on one frame out of four, and the lens move
+ * requested after a statistics frame is applied before the next statistics
+ * frame starts its exposure, so each statistics frame measures the previous
+ * position. After the long jump back to the far end one more statistics frame
+ * is skipped to let the lens settle.
+ *
+ * The algorithm is only active when listed in the tuning file of a sensor with
+ * a focus lens:
+ *
+ *   - Af:
+ *       min: 0
+ *       max: 1023
+ *       coarseStep: 64
+ *       fineStep: 16
+ */
+
+#include "af.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+namespace ipa::softisp::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftIspAf)
+
+int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	min_ = tuningData["min"].get<int32_t>(0);
+	max_ = tuningData["max"].get<int32_t>(1023);
+	coarseStep_ = std::max(1, tuningData["coarseStep"].get<int32_t>(64));
+	fineStep_ = std::max(1, tuningData["fineStep"].get<int32_t>(16));
+	rescanRatio_ = tuningData["rescanRatio"].get<double>(0.6);
+	rescanFrames_ = tuningData["rescanFrames"].get<uint32_t>(4);
+
+	if (max_ <= min_) {
+		LOG(IPASoftIspAf, Error) << "Invalid lens range " << min_ << "-" << max_;
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	state_ = State::Start;
+	context.activeState.af.pending = false;
+	return 0;
+}
+
+double Af::contrast(const SwIspStats *stats) const
+{
+	if (!stats->sharpnessSamples_ || !stats->numPixels_)
+		return -1.0;
+
+	/* Normalise by the green level so small exposure changes do not dominate. */
+	double level = static_cast<double>(stats->sum_.g()) / stats->numPixels_;
+	double grad = static_cast<double>(stats->sharpness_) / stats->sharpnessSamples_;
+	return grad / std::max(level, 1.0);
+}
+
+void Af::moveTo(IPAContext &context, int32_t position, unsigned int settle)
+{
+	position_ = std::clamp(position, min_, max_);
+	skip_ = settle;
+	context.activeState.af.position = position_;
+	context.activeState.af.pending = true;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	samples_.clear();
+	best_ = -1.0;
+	bestPos_ = min_;
+	drops_ = 0;
+	state_ = State::Coarse;
+	moveTo(context, min_, 1);
+}
+
+void Af::process(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 [[maybe_unused]] ControlList &metadata)
+{
+	if (!stats->valid)
+		return;
+
+	if (state_ == State::Start) {
+		startScan(context);
+		return;
+	}
+
+	if (skip_) {
+		skip_--;
+		return;
+	}
+
+	const double c = contrast(stats);
+	if (c < 0)
+		return;
+
+	switch (state_) {
+	case State::Coarse: {
+		samples_[position_] = c;
+		if (c > best_) {
+			best_ = c;
+			bestPos_ = position_;
+			drops_ = 0;
+		} else if (c < 0.6 * best_) {
+			drops_++;
+		}
+
+		if (drops_ >= 2 || position_ + coarseStep_ > max_) {
+			state_ = State::Fine;
+			fineEnd_ = std::min(max_, bestPos_ + coarseStep_);
+			moveTo(context, std::max(min_, bestPos_ - coarseStep_), 0);
+		} else {
+			moveTo(context, position_ + coarseStep_, 0);
+		}
+		break;
+	}
+
+	case State::Fine: {
+		samples_[position_] = c;
+		if (c > best_) {
+			best_ = c;
+			bestPos_ = position_;
+		}
+
+		if (position_ + fineStep_ > fineEnd_) {
+			state_ = State::Locked;
+			locked_ = 0.0;
+			low_ = 0;
+			moveTo(context, bestPos_, 0);
+			LOG(IPASoftIspAf, Debug)
+				<< "Focus locked at " << bestPos_ << " (contrast " << best_
+				<< ", " << samples_.size() << " positions)";
+		} else {
+			moveTo(context, position_ + fineStep_, 0);
+		}
+		break;
+	}
+
+	case State::Locked:
+		/* First frame at the final position sets the reference. */
+		if (locked_ == 0.0) {
+			locked_ = c;
+			break;
+		}
+
+		if (c < rescanRatio_ * locked_) {
+			if (++low_ >= rescanFrames_) {
+				LOG(IPASoftIspAf, Debug)
+					<< "Contrast dropped to " << c << " from " << locked_
+					<< ", refocusing";
+				startScan(context);
+			}
+		} else {
+			low_ = 0;
+			/* Follow slow changes (exposure, lighting). */
+			locked_ = 0.9 * locked_ + 0.1 * c;
+		}
+		break;
+
+	case State::Start:
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
