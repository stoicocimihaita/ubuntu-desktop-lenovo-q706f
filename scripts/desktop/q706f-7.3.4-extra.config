# Extra fragment for the v7.3.4 q706f build, merged after q706f-desktop.config and
# q706f-7.3-renames.config.

# Let devices whose suppliers never probe reach sync_state after the timeout, so the
# boot-time interconnect/clock/power-domain votes are released (measured safe on q706f).
CONFIG_FW_DEVLINK_SYNC_STATE_TIMEOUT=y

# 64 MiB default CMA area.
CONFIG_CMA_SIZE_MBYTES=64

# Since 7.2 the Qualcomm clock/pinctrl/interconnect drivers are "default ARCH_QCOM", so
# olddefconfig turns on the drivers of every other SoC. None of them can bind on SM8250;
# everything SM8250 / PM8150* / QCA6390 related stays as it is in the 7.1 config.
# CONFIG_CLK_ELIZA_DISPCC is not set
# CONFIG_CLK_ELIZA_GCC is not set
# CONFIG_CLK_ELIZA_TCSRCC is not set
# CONFIG_CLK_GLYMUR_CAMCC is not set
# CONFIG_CLK_GLYMUR_DISPCC is not set
